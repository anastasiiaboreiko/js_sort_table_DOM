"use strict";
var tbody = document.querySelector("tbody");
var tbodyArr = Array.from(tbody.rows);
function convetString(str) {
    return parseFloat(str.replace(/[$,]/g, ""));
}
function getEmployees() {
    var emplObjects = tbodyArr.map(function(row) {
        var cells = row.cells;
        return {
            name: cells[0].innerText,
            position: cells[1].innerText,
            age: cells[2].innerText,
            salary: cells[3].innerText
        };
    });
    return emplObjects;
}
function orderTable(array) {
    tbody.innerHTML = "";
    array.forEach(function(employee) {
        tbody.insertAdjacentHTML("beforeend", "<tr>\n        <td>".concat(employee.name, "</td>\n        <td>").concat(employee.position, "</td>\n        <td>").concat(employee.age, "</td>\n        <td>").concat(employee.salary, "</td>\n      </tr>"));
    });
}
var thead = Array.from(document.querySelectorAll("thead th"));
thead.forEach(function(th) {
    th.addEventListener("click", function(e) {
        if (e.target.innerText === "Name") {
            var employees = getEmployees();
            var sortedEmp = employees.sort(function(a, b) {
                return a.name.localeCompare(b.name);
            });
            orderTable(sortedEmp);
        }
        if (e.target.innerText === "Position") {
            var employees1 = getEmployees();
            var sortedEmp1 = employees1.sort(function(a, b) {
                return a.position.localeCompare(b.position);
            });
            orderTable(sortedEmp1);
        }
        if (e.target.innerText === "Age") {
            var employees2 = getEmployees();
            var sortedEmp2 = employees2.sort(function(a, b) {
                return a.age - b.age;
            });
            orderTable(sortedEmp2);
        }
        if (e.target.innerText === "Salary") {
            var employees3 = getEmployees();
            var sortedEmp3 = employees3.sort(function(a, b) {
                return convetString(a.salary) - convetString(b.salary);
            });
            orderTable(sortedEmp3);
        }
    });
});

